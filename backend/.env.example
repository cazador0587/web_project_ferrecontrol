# Puerto del servidor
PORT=3001

# Cadena de conexión a MongoDB
MONGODB_URI=mongodb://localhost:27017/ferrecontrol

# Clave para firmar los tokens JWT
JWT_SECRET=reemplazar_por_una_clave_secreta_segura

# Credenciales para el script de creación del administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=reemplazar_por_una_contrasena_segura

# URL pública del frontend autorizada por CORS
FRONTEND_URL=https://tu-frontend.example.com